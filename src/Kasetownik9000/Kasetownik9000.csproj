<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Kasetownik9000</RootNamespace>
    <AssemblyName>Kasetownik9000</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!-- Native AOT: szybki start, brak JIT -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Product>Kasetownik 9000</Product>
    <Company>KataPultoza</Company>
    <Version>1.0.0</Version>
    <Description>Projektowanie i drukowanie okładek na kasety magnetofonowe</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Obejście dla VS Build Tools 18: vcvarsall.bat woła "vswhere.exe" po nazwie, a katalogu Installer
    nie ma w PATH. Komunikat błędu trafia wtedy przed właściwą ścieżkę linkera i psuje ją.
    Zostawiamy tylko ostatni element (prawdziwy katalog z link.exe).
  -->
  <Target Name="FixNativeAotLinkerPath" AfterTargets="SetupOSSpecificProps"
          Condition="'$(_VCVarsAllFound)' == '0' and $(_CppToolsDirectory.Contains(';'))">
    <PropertyGroup>
      <_CppToolsDirectory>$(_CppToolsDirectory.Substring($([MSBuild]::Add($(_CppToolsDirectory.LastIndexOf(';')), 1))))</_CppToolsDirectory>
      <CppLinker>$(_CppToolsDirectory)link.exe</CppLinker>
      <CppLibCreator>$(_CppToolsDirectory)lib.exe</CppLibCreator>
    </PropertyGroup>
    <Message Importance="normal" Text="Naprawiono ścieżkę linkera Native AOT: $(CppLinker)" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- symbole AOT (~45 MB) nie są potrzebne w paczce dla użytkownika -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Zamiast metapakietu Microsoft.WindowsAppSDK tylko potrzebne komponenty
         (bez AI/ML/Search/Widgets — to ~60 MB, których aplikacja nie używa). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.6.5" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
  </ItemGroup>

</Project>
