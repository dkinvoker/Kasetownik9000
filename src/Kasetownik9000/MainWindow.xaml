<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kasetownik9000.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kasetownik9000"
    xmlns:editor="using:Kasetownik9000.Editor"
    xmlns:controls="using:Kasetownik9000.Controls">

    <UserControl x:Name="RootHost" FontFamily="{StaticResource RetroFont}" IsTabStop="False">
        <Grid x:Name="Root" Background="{StaticResource RetroBg0Brush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ============ PASEK TYTUŁU ============ -->
            <Grid x:Name="TitleBar" Background="{StaticResource RetroBg0Brush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="CaptionColumn" Width="150" />
                </Grid.ColumnDefinitions>
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="28" Height="28" Margin="14,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="KASETOWNIK" FontSize="17" FontWeight="Bold" CharacterSpacing="140" Foreground="{StaticResource RetroCreamBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="9000" FontSize="17" FontWeight="Bold" CharacterSpacing="60" Foreground="{StaticResource RetroOrangeBrush}" VerticalAlignment="Center" />
                    <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="2" Background="{StaticResource RetroLcdBgBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v1.5" FontFamily="{StaticResource RetroLcdFont}" FontSize="11" Foreground="{StaticResource RetroLcdFgBrush}" />
                    </Border>
                    <Border Margin="14,0,0,0" Padding="8,2" CornerRadius="3" Background="#22F3E9D2" VerticalAlignment="Center">
                        <TextBlock x:Name="DocTitleText" Text="bez tytułu" FontSize="12" Foreground="{StaticResource RetroCreamDimBrush}" />
                    </Border>
                </StackPanel>
                <!-- skośne paski jak na etykiecie kasety -->
                <Canvas Grid.Column="3" Width="96" Height="48" Margin="0,0,12,0" IsHitTestVisible="False">
                    <Polygon Points="0,48 14,48 40,0 26,0" Fill="{StaticResource RetroMustardBrush}" />
                    <Polygon Points="16,48 30,48 56,0 42,0" Fill="{StaticResource RetroOrangeBrush}" />
                    <Polygon Points="32,48 46,48 72,0 58,0" Fill="{StaticResource RetroRedBrush}" />
                    <Polygon Points="48,48 62,48 88,0 74,0" Fill="{StaticResource RetroBrownBrush}" />
                </Canvas>
            </Grid>

            <!-- ============ PASEK NARZĘDZI (klawisze magnetofonu) ============ -->
            <Border Grid.Row="1" Background="{StaticResource RetroBg1Brush}" BorderBrush="{StaticResource RetroShadowBrush}" BorderThickness="0,1,0,1" Padding="12,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Style="{StaticResource DeckKeyStyle}" Click="New_Click" ToolTipService.ToolTip="Nowy projekt (Ctrl+N)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock Text="NOWY" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeckKeyStyle}" Click="Open_Click" ToolTipService.ToolTip="Otwórz projekt (Ctrl+O)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="OTWÓRZ" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeckKeyStyle}" Click="Save_Click" ToolTipService.ToolTip="Zapisz (Ctrl+S) · Zapisz jako (Ctrl+Shift+S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                <TextBlock Text="ZAPISZ" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Margin="6,6" Fill="{StaticResource RetroLineBrush}" />
                        <Button x:Name="UndoButton" Style="{StaticResource DeckKeyStyle}" Click="Undo_Click" ToolTipService.ToolTip="Cofnij (Ctrl+Z)">
                            <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource DeckKeyStyle}" Click="Redo_Click" ToolTipService.ToolTip="Ponów (Ctrl+Y)">
                            <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                        </Button>
                        <Rectangle Width="1" Margin="6,6" Fill="{StaticResource RetroLineBrush}" />
                        <Button Style="{StaticResource DeckKeyStyle}" Click="ExportPng_Click" ToolTipService.ToolTip="Eksport do obrazu PNG (Ctrl+E)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                                <TextBlock Text="PNG" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeckKeyStyle}" Click="ExportPdf_Click" ToolTipService.ToolTip="Eksport do PDF w skali 1:1 ze znacznikami cięcia">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEA90;" FontSize="14" />
                                <TextBlock Text="PDF" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DeckKeyAccentStyle}" Click="Print_Click" Margin="6,0,0,0" ToolTipService.ToolTip="Drukuj (Ctrl+P)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE749;" FontSize="14" />
                                <TextBlock Text="DRUKUJ" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Margin="6,6" Fill="{StaticResource RetroLineBrush}" />
                        <Button x:Name="View3DButton" Style="{StaticResource DeckKeyStyle}" Click="Toggle3D_Click" ToolTipService.ToolTip="Podgląd 3D — jak okładka wygląda na kasecie (F3)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse x:Name="View3DLed" Width="8" Height="8" Fill="#FF4A2A20" Stroke="#80000000" StrokeThickness="1" VerticalAlignment="Center" />
                                <Border BorderBrush="{StaticResource RetroCreamBrush}" BorderThickness="1.5" CornerRadius="2" Padding="3,0" VerticalAlignment="Center">
                                    <TextBlock Text="3D" FontSize="10" FontWeight="Bold" CharacterSpacing="40" />
                                </Border>
                                <TextBlock Text="PODGLĄD" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Border x:Name="FormatLcdBorder" Style="{StaticResource LcdBorderStyle}" Margin="0,0,6,3">
                            <TextBlock x:Name="FormatLcd" Style="{StaticResource LcdTextStyle}" Text="J-CARD" />
                        </Border>
                        <Button Style="{StaticResource DeckKeySmallStyle}" Click="ZoomOut_Click" ToolTipService.ToolTip="Pomniejsz (Ctrl+−)">
                            <FontIcon Glyph="&#xE71F;" FontSize="13" />
                        </Button>
                        <Border Style="{StaticResource LcdBorderStyle}" MinWidth="78" Margin="0,0,0,3">
                            <TextBlock x:Name="ZoomLcd" Style="{StaticResource LcdTextStyle}" Text="100%" HorizontalAlignment="Center" />
                        </Border>
                        <Button Style="{StaticResource DeckKeySmallStyle}" Click="ZoomIn_Click" ToolTipService.ToolTip="Powiększ (Ctrl++)">
                            <FontIcon Glyph="&#xE8A3;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource DeckKeySmallStyle}" Click="ZoomFit_Click" ToolTipService.ToolTip="Dopasuj do okna (Ctrl+0)">
                            <FontIcon Glyph="&#xE740;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource DeckKeySmallStyle}" Click="Zoom100_Click" ToolTipService.ToolTip="Rzeczywisty rozmiar (Ctrl+1)">
                            <TextBlock Text="1:1" />
                        </Button>
                        <Button Style="{StaticResource DeckKeySmallStyle}" ToolTipService.ToolTip="Skróty i wskazówki">
                            <FontIcon Glyph="&#xE897;" FontSize="13" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel MaxWidth="360" Spacing="6">
                                        <TextBlock x:Name="AboutText" Text="Kasetownik 9000" FontWeight="Bold" FontSize="15" Foreground="{StaticResource RetroOrangeBrush}" Margin="0,0,0,4" />
                                        <controls:SectionHeader Text="Skróty" />
                                        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20">
                                            <Run FontWeight="Bold">Ctrl+N / O / S</Run> — nowy, otwórz, zapisz<LineBreak />
                                            <Run FontWeight="Bold">Ctrl+P</Run> — drukuj · <Run FontWeight="Bold">Ctrl+E</Run> — eksport PNG<LineBreak />
                                            <Run FontWeight="Bold">F3</Run> — podgląd 3D na kasecie (Esc — powrót)<LineBreak />
                                            <Run FontWeight="Bold">Ctrl+Z / Y</Run> — cofnij / ponów<LineBreak />
                                            <Run FontWeight="Bold">Ctrl+C / V / D</Run> — kopiuj, wklej, duplikuj<LineBreak />
                                            <Run FontWeight="Bold">Del</Run> — usuń · <Run FontWeight="Bold">Esc</Run> — odznacz<LineBreak />
                                            <Run FontWeight="Bold">Strzałki</Run> — przesuń o 0,5 mm (z Shift: 5 mm)<LineBreak />
                                            <Run FontWeight="Bold">Ctrl+kółko</Run> — zoom · <Run FontWeight="Bold">Ctrl+0</Run> — dopasuj<LineBreak />
                                            <Run FontWeight="Bold">Spacja / środkowy przycisk</Run> — przesuwanie widoku
                                        </TextBlock>
                                        <controls:SectionHeader Text="Wskazówki" Margin="0,6,0,0" />
                                        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="20">
                                            Przeciągnij obraz z Eksploratora prosto na kartę albo wklej go ze schowka (Ctrl+V).
                                            Podczas przeciągania <Run FontWeight="Bold">Shift</Run> zachowuje proporcje / prowadzi w linii prostej,
                                            a <Run FontWeight="Bold">Alt</Run> wyłącza przyciąganie. Przy obracaniu Shift skacze co 15°.
                                            Drukuj zawsze w skali 100% — wtedy karta idealnie pasuje do pudełka.
                                        </TextBlock>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ OBSZAR ROBOCZY ============ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="312" />
                </Grid.ColumnDefinitions>

                <!-- lewy panel: dodawanie + warstwy -->
                <Border Background="{StaticResource RetroBg1Brush}" BorderBrush="{StaticResource RetroShadowBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Padding="12,10,12,6" Spacing="8">
                            <controls:SectionHeader Text="Dodaj" />
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Style="{StaticResource ToolKeyStyle}" Click="AddText_Click" ToolTipService.ToolTip="Dodaj napis">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8D2;" FontSize="14" Foreground="{StaticResource RetroMustardBrush}" />
                                        <TextBlock Text="TEKST" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource ToolKeyStyle}" Click="AddImage_Click" ToolTipService.ToolTip="Dodaj obraz z pliku">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{StaticResource RetroMustardBrush}" />
                                        <TextBlock Text="OBRAZ" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" Style="{StaticResource ToolKeyStyle}" Click="AddRect_Click" ToolTipService.ToolTip="Dodaj prostokąt">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE739;" FontSize="14" Foreground="{StaticResource RetroMustardBrush}" />
                                        <TextBlock Text="PROSTOKĄT" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource ToolKeyStyle}" Click="AddEllipse_Click" ToolTipService.ToolTip="Dodaj elipsę / koło">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEA3A;" FontSize="14" Foreground="{StaticResource RetroMustardBrush}" />
                                        <TextBlock Text="ELIPSA" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="2" Style="{StaticResource ToolKeyStyle}" Click="AddLine_Click" ToolTipService.ToolTip="Dodaj linię">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE738;" FontSize="14" Foreground="{StaticResource RetroMustardBrush}" />
                                        <TextBlock Text="LINIA" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource ToolKeyStyle}" Click="AddStripes_Click" ToolTipService.ToolTip="Dodaj kolorowe paski retro">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="{StaticResource RetroMustardBrush}" />
                                        <TextBlock Text="PASKI" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource ToolKeyStyle}" Click="AddTracklist_Click" ToolTipService.ToolTip="Dodaj listę utworów (strona A i B)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{StaticResource RetroMustardBrush}" />
                                        <TextBlock Text="LISTA UTWORÓW" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <controls:SectionHeader Text="Taśma" Margin="0,6,0,0" />
                            <Border Style="{StaticResource LcdBorderStyle}" Padding="10,6" Margin="0,0,0,2">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="TapeLcdTop" Style="{StaticResource LcdTextStyle}" FontSize="12" Text="C-60   0 UTWORÓW" />
                                    <TextBlock x:Name="TapeLcdSides" Style="{StaticResource LcdTextStyle}" FontSize="12" Text="A 0:00   B 0:00" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource ToolKeyStyle}" Click="TapeCalculator_Click"
                                    ToolTipService.ToolTip="Dodaj pliki muzyczne, a aplikacja podzieli je na strony A/B i wypełni listę utworów na okładce">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{StaticResource RetroMustardBrush}" />
                                    <TextBlock Text="KALKULATOR TAŚMY" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="1" Padding="12,6,12,12" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:SectionHeader Text="Warstwy" />
                            <Border Grid.Row="1" Background="{StaticResource RetroBg0Brush}" CornerRadius="4" BorderBrush="{StaticResource RetroShadowBrush}" BorderThickness="1">
                                <ListView x:Name="LayersList" SelectionMode="Single" SelectionChanged="Layers_SelectionChanged" Padding="0,4">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="32" />
                                            <Setter Property="Padding" Value="10,0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:LayerItem">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{StaticResource RetroMustardBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Opacity="{x:Bind TextOpacity}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <FontIcon Grid.Column="2" Glyph="{x:Bind StateGlyph}" FontSize="11" Opacity="0.7" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                            <Grid Grid.Row="2" ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LayerUpButton" Style="{StaticResource DeckKeySmallStyle}" HorizontalAlignment="Stretch" Click="Forward_Click" ToolTipService.ToolTip="Wyżej (przed inne)">
                                    <FontIcon Glyph="&#xE74A;" FontSize="12" />
                                </Button>
                                <Button x:Name="LayerDownButton" Grid.Column="1" Style="{StaticResource DeckKeySmallStyle}" HorizontalAlignment="Stretch" Click="Backward_Click" ToolTipService.ToolTip="Niżej (za inne)">
                                    <FontIcon Glyph="&#xE74B;" FontSize="12" />
                                </Button>
                                <Button x:Name="LayerLockButton" Grid.Column="2" Style="{StaticResource DeckKeySmallStyle}" HorizontalAlignment="Stretch" Click="ToggleLock_Click" ToolTipService.ToolTip="Zablokuj / odblokuj">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" />
                                </Button>
                                <Button x:Name="LayerHideButton" Grid.Column="3" Style="{StaticResource DeckKeySmallStyle}" HorizontalAlignment="Stretch" Click="ToggleHide_Click" ToolTipService.ToolTip="Ukryj / pokaż">
                                    <FontIcon Glyph="&#xE7B3;" FontSize="12" />
                                </Button>
                                <Button x:Name="LayerDeleteButton" Grid.Column="4" Style="{StaticResource DeckKeySmallStyle}" HorizontalAlignment="Stretch" Click="Delete_Click" ToolTipService.ToolTip="Usuń (Del)">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FFE0705E" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- płótno -->
                <editor:EditorView x:Name="CardEditor" Grid.Column="1" />
                <editor:Preview3DView x:Name="Preview3D" Grid.Column="1" Visibility="Collapsed" />
                <!-- zakładki kart projektu (J-card, naklejki…) -->
                <StackPanel x:Name="CardTabsBar" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="16,14,16,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel x:Name="CardTabsHost" Orientation="Horizontal" Spacing="6" />
                    <Button x:Name="AddCardButton" Style="{StaticResource DeckKeySmallStyle}" ToolTipService.ToolTip="Dodaj kartę do projektu (np. naklejki na kasetę)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="KARTA" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <InfoBar x:Name="Toast" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" MaxWidth="620" IsOpen="False"
                         Background="#F22B241F" BorderBrush="#4E4138" />

                <!-- prawy panel: właściwości -->
                <Border Grid.Column="2" Background="{StaticResource RetroBg1Brush}" BorderBrush="{StaticResource RetroShadowBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer x:Name="PropsScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="14,10,16,20">

                            <!-- ===== KARTA (nic nie zaznaczono) ===== -->
                            <StackPanel x:Name="DocSection">
                                <controls:SectionHeader Text="Album" />
                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Tytuł  {tytuł}" />
                                <TextBox x:Name="AlbumTitleBox" TextChanged="AlbumField_TextChanged" />
                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Wykonawca  {wykonawca}" />
                                <TextBox x:Name="AlbumArtistBox" TextChanged="AlbumField_TextChanged" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource PropLabelStyle}" Text="Rok  {rok}" />
                                        <TextBox x:Name="AlbumYearBox" TextChanged="AlbumField_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource PropLabelStyle}" Text="Data  {data}" />
                                        <TextBox x:Name="AlbumDateBox" TextChanged="AlbumField_TextChanged" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Dopisek  {dopisek}" />
                                <TextBox x:Name="AlbumNoteBox" TextChanged="AlbumField_TextChanged" PlaceholderText="np. dla: Ciebie ♥" />
                                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,8,0,14"
                                           Text="Pola w nawiasach {…} możesz wpisać w każdym tekście — na wszystkich kartach podstawią się te wartości. Listy utworów: {lista A}, {lista B} (z kalkulatora taśmy)." />

                                <controls:SectionHeader Text="Karta" />
                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Format" />
                                <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch" SelectionChanged="FormatCombo_SelectionChanged" />
                                <TextBlock x:Name="FormatDescription" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" />
                                <ComboBox x:Name="InsideFlipCombo" Header="Wnętrze ogląda się po obróceniu kartki" Margin="0,10,0,0"
                                          HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="InsideFlip_SelectionChanged" />
                                <Grid ColumnSpacing="8" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="CardWidthBox" Header="Szerokość (mm)" Minimum="10" Maximum="300" ValueChanged="CardWidth_ValueChanged" />
                                    <NumberBox x:Name="BleedBox" Grid.Column="1" Header="Spad (mm)" Minimum="0" Maximum="5" ValueChanged="Bleed_ValueChanged"
                                               ToolTipService.ToolTip="Zapas grafiki poza linią cięcia — nie zostaną białe brzegi po obcięciu" />
                                </Grid>
                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Panele (od góry) — wysokość w mm" />
                                <StackPanel x:Name="PanelsHost" Spacing="6" />
                                <Button x:Name="AddPanelButton" Margin="0,8,0,0" Click="AddPanel_Click" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Dodaj panel" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Kolor tła" />
                                <controls:ColorButton x:Name="CardBackgroundButton" />
                                <Border Margin="0,18,0,0" Padding="12" CornerRadius="4" Background="#1AF2B035" BorderBrush="#33F2B035" BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="JAK ZACZĄĆ" FontSize="11" FontWeight="Bold" CharacterSpacing="120" Foreground="{StaticResource RetroMustardBrush}" />
                                        <TextBlock Style="{StaticResource HintTextStyle}" Opacity="1"
                                                   Text="Kliknij element na karcie, żeby go edytować. Dodawaj nowe z panelu po lewej, przeciągaj obrazy z Eksploratora, a gdy skończysz — DRUKUJ (w skali 100%) i zegnij kartę wzdłuż przerywanych linii." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ===== ELEMENT ===== -->
                            <StackPanel x:Name="ElementSection" Visibility="Collapsed">
                                <controls:SectionHeader x:Name="ElementHeader" Text="Element" />
                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Nazwa" />
                                <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" />

                                <Grid ColumnSpacing="8" RowSpacing="8" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <NumberBox x:Name="XBox" Header="X (mm)" ValueChanged="Geometry_ValueChanged" />
                                    <NumberBox x:Name="YBox" Grid.Column="1" Header="Y (mm)" ValueChanged="Geometry_ValueChanged" />
                                    <NumberBox x:Name="WBox" Grid.Row="1" Header="Szerokość" Minimum="0.5" ValueChanged="Geometry_ValueChanged" />
                                    <NumberBox x:Name="HBox" Grid.Row="1" Grid.Column="1" Header="Wysokość" Minimum="0.5" ValueChanged="Geometry_ValueChanged" />
                                    <NumberBox x:Name="RotationBox" Grid.Row="2" Header="Obrót (°)" Minimum="-360" Maximum="360" ValueChanged="Geometry_ValueChanged" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                        <Button Click="RotateLeft_Click" ToolTipService.ToolTip="Obróć o 90° w lewo" Height="32">
                                            <FontIcon Glyph="&#xE7AD;" FontSize="13" RenderTransformOrigin="0.5,0.5">
                                                <FontIcon.RenderTransform>
                                                    <ScaleTransform ScaleX="-1" />
                                                </FontIcon.RenderTransform>
                                            </FontIcon>
                                        </Button>
                                        <Button Click="RotateRight_Click" ToolTipService.ToolTip="Obróć o 90° w prawo" Height="32">
                                            <FontIcon Glyph="&#xE7AD;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Krycie" />
                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="Opacity_ValueChanged" />

                                <TextBlock Style="{StaticResource PropLabelStyle}" Text="Układ" />
                                <Grid ColumnSpacing="4" RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button HorizontalAlignment="Stretch" Click="CenterH_Click" ToolTipService.ToolTip="Wyśrodkuj w poziomie na karcie">
                                        <FontIcon Glyph="&#xE8E3;" FontSize="13" />
                                    </Button>
                                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="CenterV_Click" ToolTipService.ToolTip="Wyśrodkuj w pionie w panelu">
                                        <FontIcon Glyph="&#xE8E3;" FontSize="13" RenderTransformOrigin="0.5,0.5">
                                            <FontIcon.RenderTransform>
                                                <RotateTransform Angle="90" />
                                            </FontIcon.RenderTransform>
                                        </FontIcon>
                                    </Button>
                                    <Button Grid.Column="2" HorizontalAlignment="Stretch" Click="FillPanel_Click" ToolTipService.ToolTip="Rozciągnij na cały panel (ze spadem)">
                                        <FontIcon Glyph="&#xE740;" FontSize="13" />
                                    </Button>
                                    <Button Grid.Column="3" HorizontalAlignment="Stretch" Click="Duplicate_Click" ToolTipService.ToolTip="Duplikuj (Ctrl+D)">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                    </Button>
                                    <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="BringToFront_Click" ToolTipService.ToolTip="Na wierzch">
                                        <FontIcon Glyph="&#xE898;" FontSize="13" />
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="SendToBack_Click" ToolTipService.ToolTip="Na spód">
                                        <FontIcon Glyph="&#xE896;" FontSize="13" />
                                    </Button>
                                    <ToggleButton x:Name="LockToggle" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Click="LockToggle_Click" ToolTipService.ToolTip="Zablokuj (nie da się go przesunąć myszką)">
                                        <FontIcon Glyph="&#xE72E;" FontSize="13" />
                                    </ToggleButton>
                                    <Button Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" Click="Delete_Click" ToolTipService.ToolTip="Usuń (Del)">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#FFE0705E" />
                                    </Button>
                                </Grid>

                                <!-- ~~~ TEKST ~~~ -->
                                <StackPanel x:Name="TextSection" Margin="0,14,0,0">
                                    <controls:SectionHeader Text="Tekst" />
                                    <TextBox x:Name="TextInput" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="220"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="TextInput_TextChanged" />
                                    <Button x:Name="InsertFieldButton" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="Wstaw pole, które samo podstawi tytuł, wykonawcę, listę utworów…">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{}{ }" FontWeight="Bold" Foreground="{StaticResource RetroMustardBrush}" />
                                            <TextBlock Text="Wstaw pole" />
                                            <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource PropLabelStyle}" Text="Czcionka" />
                                    <ComboBox x:Name="FontCombo" HorizontalAlignment="Stretch" MaxDropDownHeight="420" SelectionChanged="FontCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:FontItem">
                                                <TextBlock Text="{x:Bind Name}" FontFamily="{x:Bind Family}" FontSize="15" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid ColumnSpacing="8" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="FontSizeBox" Header="Rozmiar (pt)" Minimum="2" Maximum="200" ValueChanged="FontSize_ValueChanged" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Kolor" FontSize="14" Margin="0,0,0,8" />
                                            <controls:ColorButton x:Name="TextColorButton" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,10,0,0">
                                        <ToggleButton x:Name="BoldToggle" Width="34" Height="32" Padding="0" Click="TextStyle_Click" ToolTipService.ToolTip="Pogrubienie">
                                            <FontIcon Glyph="&#xE8DD;" FontSize="13" />
                                        </ToggleButton>
                                        <ToggleButton x:Name="ItalicToggle" Width="34" Height="32" Padding="0" Click="TextStyle_Click" ToolTipService.ToolTip="Kursywa">
                                            <FontIcon Glyph="&#xE8DB;" FontSize="13" />
                                        </ToggleButton>
                                        <ToggleButton x:Name="UpperToggle" Width="34" Height="32" Padding="0" Click="TextStyle_Click" ToolTipService.ToolTip="WIELKIE LITERY">
                                            <TextBlock Text="AA" FontSize="11" FontWeight="Bold" />
                                        </ToggleButton>
                                        <Rectangle Width="1" Margin="4,6" Fill="{StaticResource RetroLineBrush}" />
                                        <ToggleButton x:Name="AlignLeftToggle" Width="34" Height="32" Padding="0" Click="Align_Click" ToolTipService.ToolTip="Do lewej">
                                            <FontIcon Glyph="&#xE8E4;" FontSize="13" />
                                        </ToggleButton>
                                        <ToggleButton x:Name="AlignCenterToggle" Width="34" Height="32" Padding="0" Click="Align_Click" ToolTipService.ToolTip="Do środka">
                                            <FontIcon Glyph="&#xE8E3;" FontSize="13" />
                                        </ToggleButton>
                                        <ToggleButton x:Name="AlignRightToggle" Width="34" Height="32" Padding="0" Click="Align_Click" ToolTipService.ToolTip="Do prawej">
                                            <FontIcon Glyph="&#xE8E2;" FontSize="13" />
                                        </ToggleButton>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                                        <ToggleButton x:Name="VTopToggle" Height="32" Padding="10,0" Click="VAlign_Click" Content="Góra" ToolTipService.ToolTip="Wyrównaj do góry ramki" />
                                        <ToggleButton x:Name="VMiddleToggle" Height="32" Padding="10,0" Click="VAlign_Click" Content="Środek" ToolTipService.ToolTip="Wyśrodkuj w pionie w ramce" />
                                        <ToggleButton x:Name="VBottomToggle" Height="32" Padding="10,0" Click="VAlign_Click" Content="Dół" ToolTipService.ToolTip="Wyrównaj do dołu ramki" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource PropLabelStyle}" Text="Odstęp liter (%)" />
                                    <Slider x:Name="LetterSpacingSlider" Minimum="-10" Maximum="80" StepFrequency="1" ValueChanged="LetterSpacing_ValueChanged" />
                                    <NumberBox x:Name="LineSpacingBox" Header="Interlinia (×)" Minimum="0.5" Maximum="3" Margin="0,4,0,0" ValueChanged="LineSpacing_ValueChanged" />
                                    <CheckBox x:Name="AutoFitCheck" Margin="0,8,0,0" Content="Zmniejsz, żeby zmieścić w ramce" Click="AutoFit_Click" />
                                    <CheckBox x:Name="ShadowCheck" Content="Cień retro (przesunięta kopia)" Click="Shadow_Click" />
                                    <Grid x:Name="ShadowOptions" ColumnSpacing="8" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ColorButton x:Name="ShadowColorButton" VerticalAlignment="Bottom" />
                                        <NumberBox x:Name="ShadowOffsetBox" Grid.Column="1" Header="Przesunięcie (mm)" Minimum="0" Maximum="5" ValueChanged="ShadowOffset_ValueChanged" />
                                    </Grid>
                                </StackPanel>

                                <!-- ~~~ OBRAZ ~~~ -->
                                <StackPanel x:Name="ImageSection" Margin="0,14,0,0">
                                    <controls:SectionHeader Text="Obraz" />
                                    <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="ReplaceImage_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="13" />
                                            <TextBlock Text="Zmień obraz…" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource PropLabelStyle}" Text="Dopasowanie" />
                                    <ComboBox x:Name="FitCombo" HorizontalAlignment="Stretch" SelectionChanged="FitCombo_SelectionChanged" />
                                    <TextBlock Style="{StaticResource PropLabelStyle}" Text="Filtr" />
                                    <ComboBox x:Name="FilterCombo" HorizontalAlignment="Stretch" SelectionChanged="FilterCombo_SelectionChanged" />
                                    <TextBlock Style="{StaticResource PropLabelStyle}" Text="Odbicie lustrzane" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="FlipXToggle" HorizontalAlignment="Stretch" Height="34" Click="Flip_Click"
                                                      ToolTipService.ToolTip="Odbij w poziomie (lewa ↔ prawa)">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⇆" FontSize="16" Margin="0,-3,0,0" />
                                                <TextBlock Text="W poziomie" />
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="FlipYToggle" Grid.Column="1" HorizontalAlignment="Stretch" Height="34" Click="Flip_Click"
                                                      ToolTipService.ToolTip="Odbij w pionie (góra ↕ dół)">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="⇅" FontSize="16" Margin="0,-3,0,0" />
                                                <TextBlock Text="W pionie" />
                                            </StackPanel>
                                        </ToggleButton>
                                    </Grid>
                                    <Button Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="ImageAspect_Click" Content="Ramka w proporcjach obrazu" />
                                </StackPanel>

                                <!-- ~~~ KSZTAŁT ~~~ -->
                                <StackPanel x:Name="ShapeSection" Margin="0,14,0,0">
                                    <controls:SectionHeader Text="Kształt" />
                                    <ComboBox x:Name="ShapeKindCombo" Margin="0,8,0,0" HorizontalAlignment="Stretch" SelectionChanged="ShapeKind_SelectionChanged" />
                                    <CheckBox x:Name="FillCheck" Margin="0,8,0,0" Content="Wypełnienie" Click="ShapeFlags_Click" />
                                    <controls:ColorButton x:Name="FillColorButton" />
                                    <CheckBox x:Name="StrokeCheck" Margin="0,8,0,0" Content="Obrys" Click="ShapeFlags_Click" />
                                    <controls:ColorButton x:Name="StrokeColorButton" />
                                    <Grid ColumnSpacing="8" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="StrokeWidthBox" Header="Grubość (mm)" Minimum="0.05" Maximum="20" ValueChanged="StrokeWidth_ValueChanged" />
                                        <NumberBox x:Name="CornerRadiusBox" Grid.Column="1" Header="Zaokrąglenie" Minimum="0" Maximum="100" ValueChanged="CornerRadius_ValueChanged" />
                                    </Grid>
                                    <CheckBox x:Name="DashedCheck" Margin="0,6,0,0" Content="Linia przerywana" Click="ShapeFlags_Click" />
                                </StackPanel>

                                <!-- ~~~ PASKI ~~~ -->
                                <StackPanel x:Name="StripesSection" Margin="0,14,0,0">
                                    <controls:SectionHeader Text="Paski retro" />
                                    <TextBlock Style="{StaticResource PropLabelStyle}" Text="Gotowe zestawy" />
                                    <ComboBox x:Name="PaletteCombo" HorizontalAlignment="Stretch" PlaceholderText="Wybierz paletę…" SelectionChanged="PaletteCombo_SelectionChanged" />
                                    <TextBlock Style="{StaticResource PropLabelStyle}" Text="Kolory pasków (kliknij, żeby zmienić)" />
                                    <VariableSizedWrapGrid x:Name="StripeColorsHost" Orientation="Horizontal" ItemWidth="44" ItemHeight="36" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Button Click="AddStripe_Click" ToolTipService.ToolTip="Dodaj pasek">
                                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        </Button>
                                        <Button Click="RemoveStripe_Click" ToolTipService.ToolTip="Usuń ostatni pasek">
                                            <FontIcon Glyph="&#xE738;" FontSize="12" />
                                        </Button>
                                        <Button Click="ReverseStripes_Click" ToolTipService.ToolTip="Odwróć kolejność">
                                            <FontIcon Glyph="&#xE8CB;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                    <CheckBox x:Name="VerticalStripesCheck" Margin="0,8,0,0" Content="Paski pionowe" Click="VerticalStripes_Click" />
                                    <NumberBox x:Name="StripeGapBox" Header="Odstęp między paskami (mm)" Minimum="0" Maximum="50" Margin="0,4,0,0" ValueChanged="StripeGap_ValueChanged" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ============ PASEK STANU ============ -->
            <Border Grid.Row="3" Background="{StaticResource RetroBg0Brush}" BorderBrush="{StaticResource RetroShadowBrush}" BorderThickness="0,1,0,0">
                <Grid Padding="12,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource RetroCreamDimBrush}" TextTrimming="CharacterEllipsis"
                               Text="Przeciągaj elementy myszką · Shift: proporcje / prosto · Alt: bez przyciągania · Ctrl+kółko: zoom · spacja: przesuwanie widoku" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle Width="18" Height="2" Fill="{StaticResource RetroOrangeBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="cięcie" FontSize="11" Foreground="{StaticResource RetroCreamDimBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Line X1="0" Y1="1" X2="18" Y2="1" Stroke="{StaticResource RetroTealBrush}" StrokeThickness="2" StrokeDashArray="2,1.5" VerticalAlignment="Center" />
                            <TextBlock Text="zgięcie" FontSize="11" Foreground="{StaticResource RetroCreamDimBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource RetroLcdBgBrush}" CornerRadius="2" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="CursorLcd" Style="{StaticResource LcdTextStyle}" FontSize="11" Text="X  ---.-   Y  ---.-  MM" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </UserControl>
</Window>
