<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Kasetownik9000.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Retro.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- pomarańczowy akcent zamiast systemowego -->
            <Color x:Key="SystemAccentColor">#E8722C</Color>
            <Color x:Key="SystemAccentColorLight1">#EE8A4C</Color>
            <Color x:Key="SystemAccentColorLight2">#F2A26E</Color>
            <Color x:Key="SystemAccentColorLight3">#F6BC93</Color>
            <Color x:Key="SystemAccentColorDark1">#C95E1F</Color>
            <Color x:Key="SystemAccentColorDark2">#A34A16</Color>
            <Color x:Key="SystemAccentColorDark3">#7D380F</Color>

            <FontFamily x:Key="ContentControlThemeFontFamily">Bahnschrift</FontFamily>

            <!-- pola tekstowe (RichEdit) źle dobierają odmianę Bahnschrift — tu czytelniejszy Segoe UI -->
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F3E9D2" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C9BDA6" />
                    <SolidColorBrush x:Key="ContentDialogBackground" Color="#2B241F" />
                    <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#352C27" />
                    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#2B241F" />
                    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#2B241F" />
                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#2B241F" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#15100D" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#4DE8722C" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#66E8722C" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#80E8722C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
